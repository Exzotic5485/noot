{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "outDir": "build",
        "rootDir": "src",
        "strict": true,
        "allowSyntheticDefaultImports": true,

        "experimentalDecorators": true,
        "emitDecoratorMetadata": false,

        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,

        "types": ["bun"]
    },
    "exclude": ["build", "node_modules"]
}
